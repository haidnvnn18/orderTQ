// ============================================================
// OrderTQ - Mini ERP for B2B Wholesale (China Order)
// Database: Supabase PostgreSQL via Prisma ORM
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

/// Tiến trình hàng hóa (Goods Flow)
enum OrderStatus {
  DRAFT        // Mới tạo, chờ khách xác nhận & cọc
  DEPOSITED    // Đã nhận cọc
  PURCHASED    // Đã thanh toán cho xưởng TQ
  WAREHOUSE_CN // Hàng đang ở kho TQ (trước khi gửi về VN)
  WAREHOUSE_VN // Hàng đã về kho VN
  DELIVERING   // Đang giao cho khách
  COMPLETED    // Giao xong, thu đủ tiền
  CANCELLED    // Đơn bị hủy
}

/// Tiến trình thanh toán (Money Flow) — Tách biệt với OrderStatus
enum FinancialStatus {
  PENDING        // Chưa cọc / chưa thanh toán gì
  PARTIALLY_PAID // Đã cọc một phần, còn lại thanh toán sau
  PAID           // Đã thanh toán đủ
  REFUNDED       // Đã hoàn tiền (đơn hủy)
}

/// Trạng thái kiện hàng gộp (Shipment Batch)
enum BatchStatus {
  PACKING     // Đang gom hàng vào kiện
  IN_TRANSIT  // Kiện đang trên đường từ TQ về VN
  ARRIVED_VN  // Kiện đã về kho VN
  DISTRIBUTED // Đã phân chia hàng cho từng đơn
}

// ============================================================
// MODEL: ExchangeRateLog (Lịch sử tỷ giá CNY → VND)
// Tách bảng riêng để phục vụ báo cáo P&L chính xác theo thời điểm
// ============================================================
model ExchangeRateLog {
  id          String   @id @default(uuid()) @db.Uuid
  rateCnyVnd  Decimal  @db.Decimal(10, 2) // VD: 3520.00 đ/tệ
  source      String   @default("manual")  // "manual" | "api_vietcombank"
  note        String?

  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("exchange_rate_logs")
}

// ============================================================
// MODEL: Customer (Khách hàng B2B — Hộ kinh doanh sỉ)
// ============================================================
model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  phone          String   @unique
  email          String?
  address        String?

  // Phân loại & chính sách
  tags           String[] @default([]) // ["VIP", "KhachMoi", "HayHuyDon"]
  depositRate    Int      @default(30) // % cọc tối thiểu được áp dụng cho KH này

  // Ghi chú nội bộ — không hiện với khách
  notes          String?  @db.Text

  // Liên kết Clerk nếu sau này mở Customer Portal
  clerkUserId    String?  @unique

  // Quan hệ
  orders         Order[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // NOTE: totalDebt KHÔNG lưu ở đây vì dễ mất đồng bộ.
  // Tính realtime: SUM(totalAmountVnd) - SUM(paidAmountVnd) từ các Order ACTIVE

  // Index cho tìm kiếm nhanh
  @@index([phone])
  @@index([name])
  @@index([clerkUserId])
  @@map("customers")
}

// ============================================================
// MODEL: Supplier (Nhà máy / Xưởng TQ)
// ============================================================
model Supplier {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  platformUrl      String?   // Link 1688 / Taobao
  contactInfo      String?   // Zalo/WeChat của xưởng
  reliabilityScore Int       @default(100) // 0–100, tính từ lịch sử giao hàng

  // Quan hệ
  products         Product[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([reliabilityScore])
  @@map("suppliers")
}

// ============================================================
// MODEL: Product (Sản phẩm cha)
// ============================================================
model Product {
  id             String   @id @default(uuid()) @db.Uuid
  supplierId     String?   @db.Uuid
  title          String
  description    String?  @db.Text
  basePriceCny   Decimal  @db.Decimal(10, 2) // Giá tệ gốc (giá chung, không phân variant)
  images         Json     @default("[]")     // String[] URL ảnh từ Supabase Storage
  isActive       Boolean  @default(true)     // Soft delete — không xóa thật

  // Quan hệ
  supplier       Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([supplierId])
  @@index([isActive])
  @@index([title])
  @@map("products")
}

// ============================================================
// MODEL: ProductVariant (SKU — Biến thể sản phẩm)
// ============================================================
model ProductVariant {
  id                  String   @id @default(uuid()) @db.Uuid
  productId           String   @db.Uuid
  sku                 String   @unique // Mã quét mã vạch, VD: VAY-01-RED-90
  attributes          Json     // {"size": "90", "color": "Đỏ"}
  priceAdjustmentCny  Decimal  @default(0) @db.Decimal(10, 2) // Giá cộng thêm so với giá cha
  variantImageUrl     String?  // Ảnh riêng cho màu/variant này

  // Quan hệ
  product             Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  lineItems           OrderLineItem[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

// ============================================================
// MODEL: ShipmentBatch (Kiện hàng — Gom nhiều đơn vào 1 kiện)
// Mô phỏng nghiệp vụ: 1 kiện gom hàng của nhiều khách → gửi 1 lần về VN
// ============================================================
model ShipmentBatch {
  id                String      @id @default(uuid()) @db.Uuid
  batchCode         String      @unique // VD: BATCH-2604-01 (tự sinh)
  status            BatchStatus @default(PACKING)

  cnTrackingNumber  String?     // Mã vận đơn nội địa TQ (từ xưởng → kho TQ)
  vnTrackingNumber  String?     // Mã vận chuyển xuyên biên giới về kho VN

  totalWeightKg     Decimal?    @db.Decimal(8, 2)
  totalVolumeM3     Decimal?    @db.Decimal(8, 4)
  shippingFeeTotal  Decimal     @default(0) @db.Decimal(12, 2) // Tổng phí ship cả kiện

  notes             String?     @db.Text

  // Quan hệ
  orders            Order[]

  arrivedAtCnAt     DateTime?   // Mốc hàng về kho TQ
  arrivedAtVnAt     DateTime?   // Mốc hàng về kho VN
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
  @@index([cnTrackingNumber])
  @@index([vnTrackingNumber])
  @@map("shipment_batches")
}

// ============================================================
// MODEL: Order (Đơn hàng — Tim của hệ thống)
// ============================================================
model Order {
  id              String          @id @default(uuid()) @db.Uuid
  orderNumber     String          @unique // Tự sinh: ORD-YYMMDD-XXX

  // Quan hệ khách hàng & kiện hàng
  customerId      String          @db.Uuid
  shipmentBatchId String?         @db.Uuid // Null cho đến khi được gom vào kiện

  // Trạng thái kép
  status          OrderStatus     @default(DRAFT)
  financialStatus FinancialStatus @default(PENDING)

  // Tài chính
  exchangeRate       Decimal     @db.Decimal(10, 2) // Tỷ giá chốt tại thời điểm tạo đơn
  totalAmountVnd     Decimal     @default(0) @db.Decimal(12, 2) // Tổng tiền hàng + phí
  depositAmountVnd   Decimal     @default(0) @db.Decimal(12, 2) // Tiền cọc đề nghị
  paidAmountVnd      Decimal     @default(0) @db.Decimal(12, 2) // Tổng đã thanh toán thực tế
  shippingFeeVnd     Decimal     @default(0) @db.Decimal(12, 2) // Phí ship phân bổ cho đơn này
  serviceFeeVnd      Decimal     @default(0) @db.Decimal(12, 2) // Phí dịch vụ (% hoa hồng)

  // Vận đơn riêng của đơn hàng (trước khi gom batch)
  chinaTrackingNumber String?

  // Ghi chú
  internalNote    String?         @db.Text // Ghi chú nội bộ, khách không thấy
  customerNote    String?         @db.Text // Yêu cầu từ khách (màu, size, ghi chú giao hàng)

  // Quan hệ
  customer        Customer        @relation(fields: [customerId], references: [id])
  shipmentBatch   ShipmentBatch?  @relation(fields: [shipmentBatchId], references: [id])
  lineItems       OrderLineItem[]
  statusLogs      OrderStatusLog[]
  payments        Payment[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Index "sống còn" cho Filter + Search
  @@index([customerId])
  @@index([status])
  @@index([financialStatus])
  @@index([shipmentBatchId])
  @@index([chinaTrackingNumber])
  @@index([createdAt])
  @@map("orders")
}

// ============================================================
// MODEL: OrderLineItem (Chi tiết sản phẩm trong đơn)
// SNAPSHOT PATTERN: Lưu thông tin tại thời điểm mua, không phụ thuộc dữ liệu gốc
// ============================================================
model OrderLineItem {
  id                 String          @id @default(uuid()) @db.Uuid
  orderId            String          @db.Uuid
  variantId          String?         @db.Uuid // Nullable: nếu variant bị xóa mềm sau này

  quantity           Int

  // ------ SNAPSHOT (BẮT BUỘC — Không thể thay đổi sau khi tạo) ------
  historicalPriceCny Decimal         @db.Decimal(10, 2) // Giá tệ tại thời điểm mua
  historicalPriceVnd Decimal         @db.Decimal(12, 2) // Giá VND tại thời điểm mua (đã nhân tỷ giá)
  historicalSku      String          // SKU tại thời điểm mua
  historicalName     String          // Tên đầy đủ: "Váy công chúa – Đỏ – 90"
  historicalImageUrl String?         // Ảnh tại thời điểm mua

  // Quan hệ
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("order_line_items")
}

// ============================================================
// MODEL: Payment (Lịch sử các lần thanh toán)
// Ghi chép từng lần nhận tiền, không gộp một cục như paidAmountVnd
// ============================================================
model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  amountVnd   Decimal  @db.Decimal(12, 2)
  method      String   @default("cash") // "cash" | "bank_transfer" | "momo"
  note        String?  // VD: "Chuyển khoản Vietcombank 20/04"
  paidAt      DateTime @default(now())

  // Quan hệ
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([paidAt])
  @@map("payments")
}

// ============================================================
// MODEL: OrderStatusLog (Timeline — Lịch sử thay đổi trạng thái)
// ============================================================
model OrderStatusLog {
  id           String       @id @default(uuid()) @db.Uuid
  orderId      String       @db.Uuid
  oldStatus    OrderStatus?
  newStatus    OrderStatus
  clerkUserId  String?      // ID người thực hiện (từ Clerk Auth)
  changedByName String?     // Tên hiển thị để đọc nhanh (snapshot)
  note         String?      // Lý do thay đổi: "Khách yêu cầu hủy", "Đã nhận cọc"

  // Quan hệ
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt    DateTime     @default(now())

  @@index([orderId])
  @@index([createdAt])
  @@map("order_status_logs")
}

// ============================================================
// MODEL: ImportJob (Background Job - Theo dõi tiến độ Bulk Import)
// ============================================================
model ImportJob {
  id          String   @id @default(uuid()) @db.Uuid
  fileName    String
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  progress    Int      @default(0) // Số dòng đã duyệt
  totalRows   Int      @default(0) // Tổng số dòng trong file
  errorLog    Json?    // Nhật ký lỗi trong quá trình xử lý (VD: "Row 5: SKU đã tồn tại")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("import_jobs")
}
